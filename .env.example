# The standalone portfolio demo is the default. No credentials are required.
NEXT_PUBLIC_DEMO_MODE=true

# Connected Supabase mode (incomplete without the original database schema and RPC).
# Set NEXT_PUBLIC_DEMO_MODE=false only after configuring every required value below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_public_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=example.com

# External APIs used by the historical connected pipeline.
COMPANIES_HOUSE_API_KEY=replace_with_companies_house_api_key
SERPER_API_KEY=replace_with_serper_api_key

# Optional legacy SearchAPI integration. Disabled unless ENABLE_LINKEDIN_LOOKUP=true.
ENABLE_LINKEDIN_LOOKUP=false
SEARCH_API_KEY=replace_with_searchapi_key
SEARCH_API_URL=https://www.searchapi.io/api/v1/search

# Optional pipeline tuning. Values shown are the code defaults.
CONCURRENCY=4
MAX_COMPANIES=0
MAX_COMPANIES_TO_CHECK=250
CH_MAX_RETRIES=6
INGEST_BOOTSTRAP_MINUTES=5
INGEST_INITIAL_BACKFILL_HOURS=5
INGEST_LOCK_TTL_MINUTES=15
INGEST_LOCK_HEARTBEAT_SECONDS=60
OFFICER_CACHE_TTL_HOURS=24
OFFICER_ENRICH_CONCURRENCY=3
OFFICER_ENRICH_MAX_PER_RUN=200
SUMMARY_BACKFILL_COMPANY_LIMIT=500
DIRECTOR_BACKFILL_WINDOW_MINUTES=60
DIRECTOR_BACKFILL_MAX_PER_RUN=150
DIRECTOR_BACKFILL_CONCURRENCY=4
CONTACT_CONFIDENCE_MODE=percent
ENRICH_DEBUG_LOGS=false
